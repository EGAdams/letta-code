+def _check_image_reference(chosen, report_path=''):
+    """Locate check-images PDF for this expense's statement report.
+
+    Check images are stored alongside the statement PDF in report directories.
+    Only return a reference when the expense has a check number and a
+    corresponding check-images file exists.
+    """
+    chosen = chosen or {}
+    check_number = str(chosen.get('check_number') or '').strip()
+
+    # Try extracting check number from description if not in field
+    if not check_number:
+        import re
+        description = str(chosen.get('description') or '')
+        match = re.search(r'check\s*#?\s*([0-9]{3,})', description, re.I)
+        if match:
+            check_number = match.group(1)
+
+    if not check_number:
+        return ''
+
+    # Find check-images PDF in report directory
+    if not report_path:
+        return ''
+
+    split = _split_report_url(unquote(report_path.split('?', 1)[0]))
+    if not split:
+        return ''
+
+    base, rel = split
+    report_dir = os.path.dirname(os.path.abspath(os.path.join(base, rel)))
+
+    # Look for check-images PDF in the report directory
+    if os.path.isdir(report_dir):
+        for filename in os.listdir(report_dir):
+            lower = filename.lower()
+            if 'check' in lower and 'image' in lower and filename.endswith('.pdf'):
+                check_images_path = os.path.join(report_dir, filename)
+                if os.path.isfile(check_images_path):
+                    return check_images_path
+
+    return ''
+
