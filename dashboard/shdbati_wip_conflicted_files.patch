+    def _sync_separate_receipt_metadata_table(
+        self, cur: Any, expense_id: int, old_id_light: str,
+        new_id_light: str, transaction_date: str, total_amount: float
+    ) -> None:
+        """Synchronize the separate receipt_metadata table row when id_light changes.
+
+        The separate receipt_metadata table has columns:
+        - expense_id (unique)
+        - raw_response (JSON)
+        - id_light (unique)
+
+        This method:
+        1. Checks if the table exists (fail gracefully if not)
+        2. Verifies the row exists and old_id_light matches (ownership check)
+        3. Updates id_light and raw_response transaction_date/total_amount
+        4. Preserves other raw_response JSON fields
+        5. Handles missing/mismatched/malformed rows safely
+        """
+        import json
+
+        # Check if receipt_metadata table exists
+        try:
+            cur.execute(
+                "SELECT COUNT(*) as cnt FROM INFORMATION_SCHEMA.TABLES "
+                "WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'receipt_metadata'"
+            )
+            table_exists = cur.fetchone()['cnt'] > 0
+            if not table_exists:
+                return  # Table doesn't exist, nothing to sync
+        except Exception:  # noqa: BLE001
+            return  # Can't check table existence, skip sync
+
+        # Read the existing row for this expense_id
+        try:
+            cur.execute(
+                'SELECT id_light, raw_response FROM receipt_metadata WHERE expense_id = %s',
+                (expense_id,)
+            )
+            meta_row = cur.fetchone()
+        except Exception:  # noqa: BLE001
+            # Table might not exist or query failed, skip sync
+            return
+
+        if not meta_row:
+            # No metadata row for this expense_id, nothing to update
+            return
+
+        # Verify old id_light matches (ownership check)
+        stored_id_light = (meta_row.get('id_light') or '').strip()
+        if stored_id_light != old_id_light:
+            # Mismatch: this expense doesn't own this metadata row
+            return
+
+        # Parse and update raw_response JSON
+        raw_response = meta_row.get('raw_response')
+        try:
+            if isinstance(raw_response, str):
+                response_data = json.loads(raw_response)
+            elif isinstance(raw_response, dict):
+                response_data = raw_response
+            else:
+                response_data = {}
+        except (ValueError, TypeError):
+            # Malformed JSON: preserve the raw payload as-is, only update id_light
+            # This allows the relational id_light update even when raw_response is broken
+            try:
+                cur.execute(
+                    'UPDATE receipt_metadata SET id_light = %s WHERE expense_id = %s',
+                    (new_id_light, expense_id)
+                )
+            except Exception:  # noqa: BLE001
+                pass  # Update failed, but we tried
+            return
+
+        # Update transaction_date and total amount in raw_response
+        if 'transaction_date' in response_data or transaction_date:
+            response_data['transaction_date'] = transaction_date
+        if 'total' in response_data or total_amount is not None:
+            response_data['total'] = float(total_amount)
+
+        # Update the separate table row
+        try:
+            cur.execute(
+                'UPDATE receipt_metadata SET id_light = %s, raw_response = %s WHERE expense_id = %s',
+                (new_id_light, json.dumps(response_data), expense_id)
+            )
+        except Exception:  # noqa: BLE001
+            # Unique constraint violation on id_light, or other SQL error
+            # Rollback will be triggered by the outer try/except
+            raise
+
