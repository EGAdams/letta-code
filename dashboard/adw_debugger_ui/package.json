{
  "name": "adw-debugger-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live ADW Sequence Debugger for the dashboard's Terminal tab. Builds to ../js/adw-debugger/.",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "15.11.7",
    "puppeteer-core": "23.10.4",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
